# ==========================================
# VeriSure AI — Environment Configuration
# ==========================================

ENVIRONMENT=development
DEBUG=True
PROJECT_NAME=VeriSure AI
API_V1_STR=/api/v1

# Security
SECRET_KEY=verisure-development-secret-key-change-in-production-demo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Configuration (Primary)
POSTGRES_USER=verisure_app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=verisure_db
DATABASE_URL=postgresql+asyncpg://verisure_app:change-me-strong-password@localhost:5432/verisure_db
DATABASE_SYNC_URL=postgresql+psycopg2://verisure_app:change-me-strong-password@localhost:5432/verisure_db

# Optional SQLite Fallback (for lightweight isolated unit tests):
# DATABASE_URL=sqlite+aiosqlite:///./verisure.db
# DATABASE_SYNC_URL=sqlite:///./verisure.db

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/storage
MAX_UPLOAD_SIZE_MB=15

# AI Device & Engine Settings
AI_DEVICE=cpu
OCR_CONFIDENCE_THRESHOLD=0.50
QUALITY_MIN_SCORE=0.60
FUSION_WEIGHTS_VERSION=v1.0
DECISION_RULES_VERSION=v1.0
